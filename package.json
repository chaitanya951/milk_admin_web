{
  "name": "dairydirect",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n admin,store -c green,cyan \"npm:dev:admin\" \"npm:dev:store\"",
    "dev:admin": "npm run dev -w @dairydirect/admin-web",
    "dev:store": "npm run dev -w @dairydirect/store-web",
    "build": "npm run build:admin && npm run build:store",
    "build:admin": "npm run build -w @dairydirect/admin-web",
    "build:store": "npm run build -w @dairydirect/store-web",
    "lint": "npm run lint -w @dairydirect/admin-web && npm run lint -w @dairydirect/store-web",
    "lint:admin": "npm run lint -w @dairydirect/admin-web",
    "lint:store": "npm run lint -w @dairydirect/store-web",
    "typecheck": "npm run typecheck -w @dairydirect/admin-web && npm run typecheck -w @dairydirect/store-web",
    "test": "npm run test -w @dairydirect/admin-web && npm run test -w @dairydirect/store-web",
    "test:admin": "npm run test -w @dairydirect/admin-web",
    "test:store": "npm run test -w @dairydirect/store-web",
    "preview:admin": "npm run preview -w @dairydirect/admin-web",
    "preview:store": "npm run preview -w @dairydirect/store-web"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
