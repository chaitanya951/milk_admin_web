# store-web env (copy to .env) — Store Manager Portal on http://localhost:5174

# ── Demo mode (demo account panel on the store login page) ─────
# Demo account: chaitanya.raju@srm.edu.in / Store@123
VITE_DEMO_MODE=true

# ── Backend mode ────────────────────────────────────────────────
# The app ALWAYS runs with the built-in shared mock data layer.
# Set VITE_USE_SUPABASE=true AND fill the keys below to switch to Supabase.
# Use the SAME project as admin-web so data stays connected.
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Integrations (mock mode when empty) ─────────────────────────
VITE_RAZORPAY_KEY_ID=
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_FROM_NUMBER=

# ── Mock layer latency (ms). Unset = random 60–120 ms per call ─────────
VITE_MOCK_LATENCY=
