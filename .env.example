# Root env — both apps read their OWN apps/<app>/.env files (Vite is per-app).
# This file documents the variables shared by both apps.

# ── Demo mode (demo accounts panel on the login pages) ──────────
# Only when VITE_DEMO_MODE=true do the demo credentials appear/pre-fill.
VITE_DEMO_MODE=true

# ── Backend mode ────────────────────────────────────────────────
# Both apps ALWAYS run with the built-in shared mock data layer.
# Set VITE_USE_SUPABASE=true AND fill the keys below to switch to Supabase
# (both apps must point at the SAME project so data stays connected).
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Integrations (mock mode when empty) ─────────────────────────
VITE_RAZORPAY_KEY_ID=
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_FROM_NUMBER=

# ── Mock layer latency (ms). Unset = random 60–120 ms per call ─────────
VITE_MOCK_LATENCY=
